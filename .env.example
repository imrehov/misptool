POSTGRES_DB=misptool
POSTGRES_USER=misptool
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

CLOUDFLARE_TUNNEL_TOKEN=your_token_here

MISP_DB_URL=postgresql+psycopg://misptool:change_me@postgres:5432/misptool

API_PORT=8000
WEB_PORT=8080

# Generate with: .venv/bin/python -m scripts.hash_password
# Keep the generated hash in single quotes to preserve its dollar signs.
APP_PASSWORD_HASH=''
# Keep true on your HTTPS domain. Set false only for local HTTP development.
AUTH_COOKIE_SECURE=true
# Exact browser origins, separated by commas. Add your HTTPS domain when deploying.
AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
